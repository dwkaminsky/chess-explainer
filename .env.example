# Copy to .env before starting Compose.  The defaults are local-only and are
# intentionally not secrets suitable for a public deployment.
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess
POSTGRES_DB=chess
DATABASE_URL=postgresql+psycopg://chess:chess@db:5432/chess
ENGINE_PATH=/usr/games/stockfish
ENGINE_VERSION=stockfish-15.1-4
SEARCH_TIME_SECONDS=3.0
HARD_ATTEMPT_TIMEOUT_SECONDS=10.0
ENGINE_THREADS=1
ENGINE_HASH_MB=64
CANDIDATE_TARGET=3
MAX_CONTINUATION_PLIES=6
LEASE_SECONDS=30.0
POLL_INTERVAL_SECONDS=0.5
MAX_REQUEST_BODY_BYTES=4096
